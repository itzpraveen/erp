# Production Environment Variables - SAMPLE FILE
# Copy this file to .env and fill in your own values before deployment

# MongoDB Configuration
MONGO_USER=admin
MONGO_PASSWORD=your_secure_password_here
MONGO_URI=mongodb://mongodb:27017/solar-erp

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_here

# Application Settings
NODE_ENV=production
PORT=5001
