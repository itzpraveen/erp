# Node environment (development, production, test)
NODE_ENV=development

# Server port
PORT=5001

# MongoDB connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/erp?retryWrites=true&w=majority

# JWT settings
JWT_SECRET=your-jwt-secret-key-should-be-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,https://your-domain.com

# Redis (optional, for session storage and caching)
# REDIS_URI=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# Log level (debug, info, warn, error)
LOG_LEVEL=info
