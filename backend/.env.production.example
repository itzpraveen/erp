# Production environment configuration
NODE_ENV=production

# Server port (Railway will provide this as PORT)
PORT=5001

# MongoDB Atlas connection string
# Replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://itzpraveenv:password@tenaga.7td1c.mongodb.net/erp?retryWrites=true&w=majority&appName=tenaga

# JWT settings (use a strong, unique secret in production)
JWT_SECRET=replace-with-a-secure-random-string-at-least-32-chars-long

# CORS configuration (comma-separated list of allowed origins)
# In production, specify exact domains rather than wildcards
ALLOWED_ORIGINS=https://your-app-domain.com,https://www.your-app-domain.com

# Redis (optional, for session storage and caching)
# REDIS_URI=redis://redis-host:6379
# REDIS_PASSWORD=your-strong-redis-password

# Log level
LOG_LEVEL=info
